</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">        function handleInput(e) {<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">            // Prevent default scrolling behavior for Space<!-- --=
>
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">            if (e.type =3D=3D=3D 'keydown' &amp;&amp; e.code =3D=
=3D=3D 'Space') {<!-- -->
