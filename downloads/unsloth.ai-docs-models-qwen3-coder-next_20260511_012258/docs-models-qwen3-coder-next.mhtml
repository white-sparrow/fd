</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">        // --- The Bird Object ---<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">        const bird =3D {<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">            x: 50,<!-- -->
