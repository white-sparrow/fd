|| 0;<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">        let gameState =3D 'START'; // START, PLAYING, GAMEOVER<!--=
 -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">        const gravity =3D 0.25;<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
