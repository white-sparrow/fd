content">            radius: 15,<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">            draw: function() {<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.fillStyle =3D "#FFD700"; // Gold color<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.beginPath();<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.arc(this.x + this.radius, this.y + this.radius=
, this.radius, 0, Math.PI * 2);<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.fill();<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.lineWidth =3D 2;<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.stroke();<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                // Eye<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.fillStyle =3D "white";<!-- -->
</span></span><span class=3D"highlight-line"><span class=3D"highlight-line-=
content">                ctx.beginPath();<!-- -->
